# Copy this file to .streamlit/secrets.toml (same folder name, drop ".example")
# and fill in real values. NEVER commit the real secrets.toml to git —
# it's already excluded via .gitignore below.
#
# If deploying on Streamlit Community Cloud, you don't need this file at all —
# paste these same key/value pairs into the app's "Secrets" settings in the
# Streamlit Cloud dashboard instead.

MOENGAGE_WORKSPACE_ID = "your_workspace_id"
MOENGAGE_API_KEY = "your_api_key"
MOENGAGE_DATA_CENTER = "01"
SLACK_WEBHOOK_URL = ""
